# Файл необязателен: без него `docker compose up --build` запускает сервис, а вызовы моделей,
# платные источники и исследовательский корпус идут через сервер проекта (api.1f608.com).
# Заполните то, что хотите вызывать напрямую своими ключами, и скопируйте в .env.

# Режим маршрутизации:
#   auto  - свой ключ задан: напрямую; ключа нет: через сервер проекта (по умолчанию)
#   local - сервер проекта не используется; сервис без ключа отключается
#   relay - всё, что умеет сервер проекта, идёт через него, даже при наличии ключа
WSIGNAL_MODE=auto
# Для одного сервиса: direct | relay (LLM, CORPUS, BRAVE, EPO, ROSPATENT, X)
# WSIGNAL_ROUTE_LLM=direct
# WSIGNAL_RELAY_URL=https://api.1f608.com

# Модели (OpenRouter)
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Модель для роли: WSIGNAL_LLM_MODEL_ORCHESTRATOR, _ASSISTANT, _RESEARCHER, _REFUTER, _EXTRACTOR

# Исследовательский корпус: адрес собственного сервера корпуса (если есть)
CORPUS_URL=

# Платные источники. Без ключа Brave идёт через сервер проекта; EPO, Роспатент и X
# без ключа отключаются, агенты используют бесплатные источники.
BRAVE_API_KEY=
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET_KEY=
SEARCHPLATFORM_ROSPATENT_API=
X_BEARER_TOKEN=

# Необязательно. OpenAlex работает без ключа; CONTACT_EMAIL уходит с его запросами.
OPENALEX_API_KEY=
CONTACT_EMAIL=

# Порт сервиса и база данных
API_PORT=8000
POSTGRES_USER=wsignal
POSTGRES_PASSWORD=wsignal
POSTGRES_DB=wsignal
POSTGRES_PORT=55432

# Бюджет времени запуска, минут (ориентир для оркестратора, запуск не прерывает)
WSIGNAL_RUN_BUDGET_MINUTES=20
